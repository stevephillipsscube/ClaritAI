    <environments>Default</environments>
    <formulas>
        <name>Proceeding_Date_Formatted</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.Date_Time_of_Meeting__c})</expression>
    </formulas>
    <formulas>
        <name>Proceeding_Date_Long</name>
        <dataType>String</dataType>
        <expression>CASE(
  MOD({!Proceeding_Date_Formatted} - DATE(1985,6,24), 7),
  0, &quot;Sunday&quot;,
  1, &quot;Monday&quot;,
  2, &quot;Tuesday&quot;,
  3, &quot;Wednesday&quot;,
  4, &quot;Thursday&quot;,
  5, &quot;Friday&quot;,
  6, &quot;Saturday&quot;,
  &quot;Error&quot;
) &amp; &quot;, &quot; &amp;
CASE(
  MONTH({!Proceeding_Date_Formatted}),
  1, &quot;January&quot;,
  2, &quot;February&quot;,
  3, &quot;March&quot;,
  4, &quot;April&quot;,
  5, &quot;May&quot;,
  6, &quot;June&quot;,
  7, &quot;July&quot;,
  8, &quot;August&quot;,
  9, &quot;September&quot;,
  10, &quot;October&quot;,
  11, &quot;November&quot;,
  12, &quot;December&quot;,
  &quot;Error&quot;
) &amp; &quot; &quot; &amp;
TEXT(DAY({!Proceeding_Date_Formatted})) &amp; &quot;, &quot; &amp;
TEXT(YEAR({!Proceeding_Date_Formatted}))</expression>
    </formulas>
    <interviewLabel>Proceeding Agenda Item Emails {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Proceeding Agenda Item Emails - Planning Department</label>
    <processMetadataValues>
